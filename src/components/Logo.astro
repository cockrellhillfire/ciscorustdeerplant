---
import AntlerMark from './AntlerMark.astro';
interface Props {
  size?: 'sm' | 'lg';
  class?: string;
}
const { size = 'sm', class: className = '' } = Astro.props;
const lg = size === 'lg';
---

<span class:list={['inline-flex items-center gap-3 leading-none', className]}>
  <AntlerMark class={lg ? 'h-16 w-16 text-blaze' : 'h-9 w-9 text-blaze'} />
  <span class="flex flex-col">
    <span class:list={['font-display uppercase tracking-wide text-cream', lg ? 'text-4xl' : 'text-[1.45rem]']}>Rust Deer Plant</span>
    <span
      class:list={[
        'font-cond font-semibold uppercase text-sand',
        lg ? 'mt-1.5 text-base tracking-[0.32em]' : 'mt-1 text-[0.68rem] tracking-[0.3em]',
      ]}>Wild Game Processing</span
    >
  </span>
</span>
