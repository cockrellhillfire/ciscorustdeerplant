---
/**
 * Click-to-load Google Map. The page makes no request to Google until the visitor asks for the map,
 * which keeps the site fast and free of third-party cookies by default.
 */
import { biz, fullAddress } from '../lib/business';
import Icon from './Icon.astro';
import AntlerMark from './AntlerMark.astro';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['relative overflow-hidden rounded-sm border border-white/10 bg-char-2', className]} data-map>
  <div class="grain absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center" data-map-facade>
    <svg class="absolute inset-0 h-full w-full text-white/[0.05]" aria-hidden="true">
      <defs>
        <pattern id="topo" width="80" height="80" patternUnits="userSpaceOnUse">
          <path d="M0 40c20-18 40 18 80 0M0 10c20-18 40 18 80 0M0 70c20-18 40 18 80 0" fill="none" stroke="currentColor" stroke-width="2"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#topo)"></rect>
    </svg>
    <AntlerMark class="relative h-14 w-14 text-blaze" />
    <p class="relative font-display text-2xl uppercase text-cream sm:text-3xl">{biz.address.street}</p>
    <p class="relative -mt-2 text-bone">{biz.address.city}, {biz.address.state} {biz.address.zip}</p>
    <div class="relative flex flex-wrap justify-center gap-3">
      <button type="button" class="btn btn-ghost" data-map-load>
        <Icon name="pin" /> Show map
      </button>
      <a href={biz.directionsUrl} class="btn btn-primary" rel="noopener" target="_blank">
        Get directions <span class="sr-only">(opens Google Maps)</span>
      </a>
    </div>
    <p class="relative max-w-xs text-xs text-muted">Loading the map connects to Google Maps.</p>
  </div>
  <template data-map-template>
    <iframe
      title={`Map showing ${biz.name} at ${fullAddress}`}
      src={biz.mapEmbedUrl}
      class="absolute inset-0 h-full w-full border-0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen></iframe>
  </template>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((wrap) => {
    const btn = wrap.querySelector<HTMLButtonElement>('[data-map-load]');
    const tpl = wrap.querySelector<HTMLTemplateElement>('[data-map-template]');
    const facade = wrap.querySelector<HTMLElement>('[data-map-facade]');
    btn?.addEventListener('click', () => {
      if (!tpl || !facade) return;
      wrap.appendChild(tpl.content.cloneNode(true));
      facade.remove();
      wrap.querySelector('iframe')?.focus();
    });
  });
</script>
