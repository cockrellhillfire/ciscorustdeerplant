---
/**
 * Inner-page header styled like the shop's flyers: centered, stacked type over a dark photo,
 * an orange title ribbon, and a torn paper edge into the next section.
 */
import { Picture } from 'astro:assets';
import type { Photo } from '../lib/business';
import AntlerMark from './AntlerMark.astro';
interface Props {
  eyebrow: string;
  title: string;
  ribbon?: string;
  lead?: string;
  photo?: Photo;
  position?: string;
  /** Color of the section that follows, so the torn edge blends into it. */
  next?: 'cream' | 'char' | 'ink';
}
const { eyebrow, title, ribbon, lead, photo, position = 'center', next = 'char' } = Astro.props;
const nextBg = { cream: 'bg-cream', char: 'bg-char', ink: 'bg-ink' }[next];
---

<section class:list={['relative', nextBg]}>
  <div class="torn-bottom grain relative isolate overflow-hidden bg-ink pb-6">
    {
      photo && (
        <Picture
          src={photo.src}
          alt=""
          formats={['avif', 'webp']}
          widths={[640, 960, 1440, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-20 h-full w-full object-cover opacity-40"
          style={`object-position:${position}`}
        />
      )
    }
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgb(18_16_14/0.55),rgb(18_16_14/0.92)_70%)]" aria-hidden="true"></div>
    <div class="container-x flex flex-col items-center py-16 text-center sm:py-20">
      <AntlerMark class="h-10 w-10 text-blaze" />
      <p class="ruled eyebrow mt-4 !text-sand">{eyebrow}</p>
      <h1 class="mt-3 max-w-4xl text-[3.4rem] text-cream sm:text-7xl lg:text-8xl">{title}</h1>
      {ribbon && <p class="ribbon ribbon-skew mt-6 px-8 py-2 font-cond text-lg font-bold uppercase tracking-[0.14em] sm:text-xl">{ribbon}</p>}
      {lead && <p class="mt-6 max-w-2xl text-lg text-bone sm:text-xl">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
