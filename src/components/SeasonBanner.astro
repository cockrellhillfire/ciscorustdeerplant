---
import { biz, seasonBanner } from '../lib/business';
import Icon from './Icon.astro';
const status = biz.season.status;
const tone = status === 'closed' ? 'bg-char-3 text-cream' : 'bg-blaze text-ink';
---

<div class:list={['relative z-40 text-center', tone]} role="region" aria-label="Season status">
  <p class="container-x flex items-center justify-center gap-2 py-2 font-cond text-[0.95rem] font-bold uppercase leading-snug tracking-[0.06em] sm:text-base">
    <span class="hidden h-2 w-2 shrink-0 rounded-full bg-current sm:inline-block" aria-hidden="true"></span>
    <span>{seasonBanner()}</span>
    <a
      href="/drop-off/"
      class="hidden shrink-0 items-center gap-1 underline decoration-2 underline-offset-4 hover:no-underline md:inline-flex"
      >Drop-off guide <Icon name="arrow" class="h-4 w-4" /></a
    >
  </p>
</div>
