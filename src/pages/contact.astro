---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import HoursTable from '../components/HoursTable.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Icon from '../components/Icon.astro';
import { biz, photo } from '../lib/business';
const field =
  'mt-1.5 block w-full rounded-sm border border-brown/40 bg-white px-3.5 py-3 text-base text-ink placeholder:text-brown/60 focus:border-rust focus:outline-none focus:ring-2 focus:ring-rust/40';
const label = 'font-cond text-base font-bold uppercase tracking-[0.08em] text-ink';
---

<BaseLayout
  title="Contact"
  description="Call Rust Deer Plant at (254) 442-1653. 8913 Highway 6, Cisco, TX 76437. Open 9 AM–9 PM daily, October through January. Directions, hours and contact form."
>
  <PageHero eyebrow="Call, stop by or send a note" title="Contact us" photo={photo('front-office.jpg')}>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a href={`tel:${biz.phone.tel}`} class="btn btn-primary !text-xl"><Icon name="phone" /> {biz.phone.display}</a>
      <a href={`tel:${biz.phoneAlt.tel}`} class="btn btn-ghost"><Icon name="phone" /> {biz.phoneAlt.display}</a>
    </div>
  </PageHero>

  <div class="grain bg-char">
    <div class="container-x section grid gap-10 lg:grid-cols-[1fr_1.15fr]">
      <div class="space-y-8">
        <section aria-labelledby="reach-title" class="rounded-sm border border-white/10 bg-char-2 p-6">
          <h2 id="reach-title" class="text-4xl text-cream">Reach us</h2>
          <dl class="mt-5 space-y-5">
            <div class="flex gap-4">
              <dt><Icon name="phone" class="mt-1 h-6 w-6 text-blaze" label="Phone" /></dt>
              <dd>
                <a href={`tel:${biz.phone.tel}`} class="font-cond text-2xl font-bold tracking-wide text-cream hover:text-blaze">{biz.phone.display}</a>
                <span class="block text-sm text-muted">Main plant line, also on WhatsApp</span>
                <a href={`tel:${biz.phoneAlt.tel}`} class="mt-2 inline-block font-cond text-xl font-bold tracking-wide text-bone hover:text-blaze">{biz.phoneAlt.display}</a>
                <span class="block text-sm text-muted">{biz.phoneAlt.label}</span>
              </dd>
            </div>
            <div class="flex gap-4">
              <dt><Icon name="pin" class="mt-1 h-6 w-6 text-blaze" label="Address" /></dt>
              <dd>
                <address class="not-italic text-cream">{biz.address.street}<br />{biz.address.city}, {biz.address.state} {biz.address.zip}</address>
                <a href={biz.directionsUrl} rel="noopener" target="_blank" class="mt-1 inline-flex items-center gap-1 font-cond font-bold uppercase tracking-[0.1em] text-blaze hover:text-blaze-hot">
                  Open in Google Maps <Icon name="external" class="h-4 w-4" /><span class="sr-only">(opens Google Maps)</span>
                </a>
                <span class="mt-1 block text-sm text-muted">{biz.address.note}</span>
              </dd>
            </div>
            <div class="flex gap-4">
              <dt><Icon name="mail" class="mt-1 h-6 w-6 text-blaze" label="Email" /></dt>
              <dd><a href={`mailto:${biz.email}`} class="break-all text-cream hover:text-blaze">{biz.email}</a></dd>
            </div>
          </dl>
          <ul class="mt-6 flex flex-wrap gap-3 border-t border-white/10 pt-6" aria-label="Social media">
            <li><a href={biz.social.facebook} rel="noopener" target="_blank" class="btn btn-ghost !min-h-11 !px-4 !text-base"><Icon name="facebook" /> Facebook</a></li>
            <li><a href={biz.social.instagram} rel="noopener" target="_blank" class="btn btn-ghost !min-h-11 !px-4 !text-base"><Icon name="instagram" /> Instagram</a></li>
            <li><a href={biz.social.tiktok} rel="noopener" target="_blank" class="btn btn-ghost !min-h-11 !px-4 !text-base"><Icon name="tiktok" /> TikTok</a></li>
          </ul>
        </section>

        <section aria-labelledby="contact-hours-title" class="rounded-sm border border-white/10 bg-char-2 p-6 text-bone">
          <h2 id="contact-hours-title" class="text-4xl text-cream">Hours</h2>
          <div class="mt-4"><HoursTable /></div>
        </section>
      </div>

      <section aria-labelledby="form-title" class="on-light rounded-sm bg-cream p-6 text-ink sm:p-8">
        <p class="eyebrow">Send a message</p>
        <h2 id="form-title" class="mt-2 text-4xl sm:text-5xl">Drop us a line</h2>
        <p class="mt-3 text-brown">{biz.contactForm.intro}</p>

        <div class="mt-5 hidden rounded-sm border-l-4 p-4" role="status" aria-live="polite" tabindex="-1" data-form-status></div>

        <form method="post" action="/api/contact" class="mt-6 grid gap-5" data-contact-form novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class={label}>Name <span class="text-rust" aria-hidden="true">*</span></label>
              <input id="name" name="name" type="text" autocomplete="name" required maxlength="100" class={field} />
            </div>
            <div>
              <label for="phone" class={label}>Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" class={field} />
            </div>
          </div>
          <div>
            <label for="email" class={label}>Email <span class="text-rust" aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" class={field} aria-describedby="email-hint" />
            <p id="email-hint" class="mt-1 text-sm text-brown">So we can write you back.</p>
          </div>
          <div>
            <label for="topic" class={label}>About</label>
            <select id="topic" name="topic" class={field}>
              <option>General question</option>
              <option>Pricing or cut ticket</option>
              <option>Pickup</option>
              <option>European mount</option>
              <option>Specialty sausage, jerky or snack sticks</option>
              <option>Merch</option>
              <option>Jobs</option>
            </select>
          </div>
          <div>
            <label for="message" class={label}>Message <span class="text-rust" aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="6" required maxlength="4000" class={field}></textarea>
          </div>
          <!-- Spam trap: real visitors never see or fill this field. -->
          <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="started" value="" data-started />
          <p class="text-sm text-brown"><span class="text-rust" aria-hidden="true">*</span> Required</p>
          <div>
            <button type="submit" class="btn btn-dark w-full sm:w-auto" data-submit>Send message <Icon name="arrow" /></button>
          </div>
          <p class="text-sm text-brown">Need an answer today? Calling is fastest: <a href={`tel:${biz.phone.tel}`} class="font-semibold text-rust-deep underline">{biz.phone.display}</a>.</p>
        </form>
      </section>
    </div>

    <div class="container-x pb-20">
      <MapEmbed class="min-h-[26rem]" />
    </div>
  </div>

  <script>
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const status = document.querySelector<HTMLElement>('[data-form-status]');
    const started = document.querySelector<HTMLInputElement>('[data-started]');
    if (started) started.value = String(Date.now());

    const say = (ok: boolean, msg: string) => {
      if (!status) return;
      status.textContent = msg;
      status.className = `mt-5 rounded-sm border-l-4 p-4 ${ok ? 'border-green-700 bg-green-50 text-green-900' : 'border-rust bg-white text-ink'}`;
      status.focus();
    };

    // Messages after a no-JavaScript submit redirect back here.
    const params = new URLSearchParams(location.search);
    if (params.has('sent')) say(true, "Thanks! Your message is on its way. We'll get back to you soon.");
    if (params.has('error')) say(false, 'Sorry, your message could not be sent. Please call us at (254) 442-1653.');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Native validation with visible messages.
      const invalid = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')).filter((f) => !f.checkValidity());
      form.querySelectorAll('[aria-invalid]').forEach((f) => f.removeAttribute('aria-invalid'));
      if (invalid.length) {
        invalid.forEach((f) => f.setAttribute('aria-invalid', 'true'));
        say(false, 'Please fill in your name, a valid email and a message.');
        invalid[0].focus();
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>('[data-submit]');
      if (btn) btn.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          form.reset();
          say(true, "Thanks! Your message is on its way. We'll get back to you soon.");
        } else {
          say(false, data.error || 'Sorry, your message could not be sent. Please call us at (254) 442-1653.');
        }
      } catch {
        say(false, 'Sorry, your message could not be sent. Please call us at (254) 442-1653.');
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  </script>
</BaseLayout>
