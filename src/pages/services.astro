---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PriceList from '../components/PriceList.astro';
import Icon from '../components/Icon.astro';
import AntlerMark from '../components/AntlerMark.astro';
import { biz, photo, formatPrice } from '../lib/business';

const p = biz.pricing;
const jump = [
  { id: 'basic-processing', label: 'Basic' },
  { id: 'exotic-processing', label: 'Exotics' },
  { id: 'hog-processing', label: 'Hogs' },
  { id: 'fees-and-euros', label: 'Fees & Euros' },
  { id: 'cut-options', label: 'Cut Options' },
  { id: 'hog-cuts', label: 'Hog Cuts' },
  { id: 'link-sausage', label: 'Link Sausage' },
  { id: 'summer-sausage', label: 'Summer Sausage' },
  { id: 'more-specialties', label: 'Specialties' },
  { id: 'flavors', label: 'Flavors' },
  { id: 'merch', label: 'Merch' },
];
const sausage = photo('smoked-link-sausage.jpg');
const euro = photo('elk-european-mount.jpg');
const caps = photo('camo-patch-caps.jpg');
const flavorGroups = [
  { title: 'Link sausage', list: biz.flavors.linkSausage },
  { title: 'Summer sausage', list: biz.flavors.summerSausage },
  { title: 'Jerky', list: biz.flavors.jerky },
  { title: 'Snack sticks', list: biz.flavors.snackSticks },
];

const priceSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Rust Deer Plant processing and specialty price guide',
  itemListElement: [
    ...p.basicProcessing.items,
    ...p.exoticProcessing.items,
    ...p.hogProcessing.items.map((i) => ({ ...i, item: `Hog processing, ${i.item}` })),
    ...p.feesAndEuros.items.filter((i) => i.price !== null),
  ].map((i) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: i.item },
    price: i.price,
    priceCurrency: 'USD',
  })),
};
---

<BaseLayout
  title="Services & Pricing"
  description="Deer processing prices in Cisco, TX: whitetail $125, mule deer $140, elk $350, bison $900, hogs from $120, European mounts $125. Specialty sausage, jerky and snack sticks by the pound."
  jsonLd={[priceSchema]}
>
  <PageHero
    eyebrow="Services & pricing"
    title="The price guide"
    ribbon={`${p.updated} · Prices can change`}
    lead="Whitetail, mule deer, elk, hogs and exotics. Back straps, tenderloin, hind quarters, burger and chili come standard. Add sausage, jerky and euros to make it yours."
    photo={photo('butchering-table.jpg')}
    next="char"
  />

  <div class="grain bg-char pb-20">
    <!-- Section tags -->
    <nav aria-label="Price guide sections" class="container-x">
      <ul class="flex flex-wrap justify-center gap-2.5 pt-4">
        {
          jump.map((j, i) => (
            <li class:list={[i % 2 ? 'tilt-r' : 'tilt-l2']}>
              <a href={`#${j.id}`} class="hang-tag block bg-cream font-cond text-sm font-bold uppercase tracking-[0.1em] text-ink transition hover:bg-blaze [--tag-hole:var(--color-char)]">
                {j.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- The printed sheet -->
    <article class="on-light container-x mt-10 max-w-6xl" aria-labelledby="sheet-title">
      <div class="grain grain-light rounded-sm bg-[#fbf6ec] px-4 pb-10 pt-10 text-ink shadow-[0_40px_80px_-40px_rgb(0_0_0/0.9)] sm:px-10">
        <header class="text-center">
          <AntlerMark class="mx-auto h-16 w-16 text-ink" />
          <p class="mt-2 font-display text-5xl uppercase leading-none sm:text-6xl">Rust Deer Plant</p>
          <p class="ruled mt-2 font-cond text-sm font-bold uppercase tracking-[0.34em] text-rust">Wild Game Processing</p>
          <h2 id="sheet-title" class="mx-auto mt-6 max-w-3xl bg-rust px-4 py-3 font-display text-3xl uppercase text-cream sm:text-4xl">Processing & Specialty Price Guide</h2>
        </header>

        <div class="mt-10 grid gap-x-10 gap-y-8 lg:grid-cols-2">
          <div class="flex flex-col gap-8">
            <PriceList id="basic-processing" title={p.basicProcessing.title} items={p.basicProcessing.items}>
              <div class="mt-3 border-y-2 border-rust/40 py-3 text-center">
                <p class="font-cond text-sm font-bold uppercase tracking-[0.16em] text-rust">Basic cuts include</p>
                <ul class="mt-1">
                  {p.basicProcessing.basicCuts.map((c) => (
                    <li class="text-[0.98rem]"><span class="font-semibold">{c.cut}</span>{c.options && <span class="text-brown"> · {c.options}</span>}</li>
                  ))}
                </ul>
              </div>
            </PriceList>
            <PriceList id="exotic-processing" title={p.exoticProcessing.title} items={p.exoticProcessing.items}>
              <p class="mt-3 text-sm text-brown">
                Hunted out of state? We take game from New Mexico, Arizona and beyond. See the <a href="/exotics/" class="font-semibold text-rust-deep underline">exotics page</a>.
              </p>
            </PriceList>
            <PriceList id="fees-and-euros" title={p.feesAndEuros.title} items={p.feesAndEuros.items}>
              <p class="mt-3 text-sm text-brown">
                The $100 charge applies only to animals left at the after-hours drop-off with the guts in. Capes are held 7 days for your taxidermist, then $10 a day. See the <a href="/drop-off/#cape-pickup" class="font-semibold text-rust-deep underline">cape pickup policy</a>.
              </p>
            </PriceList>
            <PriceList id="hog-processing" title={p.hogProcessing.title} items={p.hogProcessing.items} />
          </div>

          <div class="flex flex-col gap-8">
            <PriceList id="cut-options" title={p.cutOptions.title}>
              <dl class="divide-y divide-brown/20">
                {
                  p.cutOptions.cuts.map((c) => (
                    <div class="py-3">
                      <dt class="font-cond text-lg font-bold uppercase tracking-[0.08em] text-rust-deep">{c.cut}</dt>
                      <dd class="mt-1">{c.options.join(' · ')}</dd>
                    </div>
                  ))
                }
              </dl>
              <ul class="mt-1 border-t border-brown/20 pt-1">
                {
                  p.cutOptions.upcharges.map((u) => (
                    <li class="price-row">
                      <span class="font-semibold italic">{u.item}</span>
                      <span class="leader" aria-hidden="true" />
                      <span class="amount">+{formatPrice(u.price)}</span>
                    </li>
                  ))
                }
              </ul>
              <p class="mt-3 border-t-2 border-rust/40 pt-3 text-center">
                <span class="font-semibold">{p.cutOptions.grind.join(' · ')}</span><br />
                <span class="text-sm text-brown">{p.cutOptions.grindNote}</span>
              </p>
            </PriceList>
            <PriceList id="hog-cuts" title={p.hogCuts.title} items={p.hogCuts.items}>
              <Fragment slot="before">
                <p class="mb-1 mt-2">{p.hogCuts.options.join(' · ')}</p>
              </Fragment>
            </PriceList>
            <PriceList id="link-sausage" title={p.linkSausage.title} items={p.linkSausage.items} />
            <PriceList id="summer-sausage" title={p.summerSausage.title} items={p.summerSausage.items} />
            <PriceList id="more-specialties" title={p.moreSpecialties.title} items={p.moreSpecialties.items} />
            <div class="reveal relative rotate-[-1.5deg] bg-rust px-6 py-6 text-center text-cream shadow-lg [clip-path:polygon(0_0,100%_0,96%_50%,100%_100%,0_100%,4%_50%)]">
              <p class="font-display text-5xl uppercase leading-none sm:text-6xl">6 lb minimum</p>
              <p class="mt-2 font-cond text-xl font-bold uppercase tracking-[0.25em]">— on all sausage —</p>
            </div>
          </div>
        </div>

        <footer class="mt-12 border-t-2 border-rust/50 pt-6 text-center">
          <p class="font-cond text-xl font-bold uppercase tracking-[0.08em]">{biz.address.street} • {biz.address.city}, {biz.address.state} {biz.address.zip}</p>
          <a href={`tel:${biz.phone.tel}`} class="mt-1 block font-display text-4xl hover:text-rust">{biz.phone.display}</a>
          <p class="script mt-2 text-3xl text-rust">{biz.tagline}</p>
          <p class="mt-4 text-sm text-brown">{p.disclaimer}</p>
        </footer>
      </div>
    </article>

    <!-- Payment, discounts, rush -->
    <section class="container-x mt-20 max-w-6xl" aria-label="Payment, discounts and rush orders">
      <div class="grid gap-8 md:grid-cols-3">
        {
          [
            { icon: 'cash', title: 'Paying for your order', text: biz.payment.policy, small: `We take ${biz.payment.methods.join(', ').toLowerCase()}.` },
            { icon: 'shield', title: biz.discounts[0].title, text: biz.discounts[0].text, small: '' },
            { icon: 'clock', title: 'Need it fast?', text: 'Rush orders are available. Ask for pricing when you drop off, or give us a call.', small: biz.phone.display },
          ].map((c, i) => (
            <div class:list={['reveal border-t-4 border-blaze pt-5 text-center', i === 1 && 'md:translate-y-6']}>
              <Icon name={c.icon as 'cash'} class="mx-auto h-9 w-9 text-blaze" />
              <h2 class="mt-3 text-3xl text-cream">{c.title}</h2>
              <p class="mt-2 text-bone">{c.text}</p>
              {c.small && <p class="mt-2 text-sm text-muted">{c.small}</p>}
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <!-- Flavors -->
  <section id="flavors" class="grain section scroll-mt-20 bg-ink" aria-labelledby="flavors-title">
    <div class="container-x">
      <div class="reveal text-center">
        <p class="ruled eyebrow">Know your flavors</p>
        <h2 id="flavors-title" class="mt-3 text-6xl text-cream sm:text-7xl">What to put on your cut ticket</h2>
        <p class="mx-auto mt-4 max-w-2xl text-bone">{biz.flavors.note} {biz.pricing.minimum}.</p>
      </div>
      <div class="mt-12 grid items-start gap-10 lg:grid-cols-[1fr_1.6fr]">
        <div class="relative mx-auto hidden w-full max-w-sm lg:block">
          <figure class="taped tilt-l">
            <Picture src={sausage.src} alt={sausage.alt} formats={['avif', 'webp']} widths={[320, 480, 640]} sizes="24rem" class="aspect-[4/5] w-full object-cover" />
          </figure>
          <figure class="taped tilt-r2 -mt-24 ml-24 w-2/3">
            <Picture src={euro.src} alt={euro.alt} formats={['avif', 'webp']} widths={[240, 400]} sizes="16rem" class="aspect-square w-full object-cover" />
          </figure>
        </div>
        <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
          {
            flavorGroups.map((g) => (
              <div class="reveal">
                <h3 class="border-b-2 border-blaze pb-2 text-3xl text-blaze">{g.title}</h3>
                <dl class="mt-4 space-y-4">
                  {g.list.map((f) => (
                    <div>
                      <dt class="font-cond text-xl font-bold uppercase tracking-[0.04em] text-cream">{f.name}</dt>
                      <dd class="text-bone">{f.description}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Merch -->
  {
    biz.merch.show && (
      <section id="merch" class="on-light grain grain-light section scroll-mt-20 bg-cream text-ink" aria-labelledby="merch-title">
        <div class="container-x max-w-4xl text-center">
          <p class="ruled eyebrow reveal">Rust gear</p>
          <h2 id="merch-title" class="reveal mt-3 text-6xl sm:text-7xl">Wear the antlers</h2>
          <p class="reveal mt-3 text-brown">{biz.merch.text}</p>
          <figure class="taped tilt-l2 reveal mx-auto mt-10 max-w-2xl">
            <Picture src={caps.src} alt={caps.alt} formats={['avif', 'webp']} widths={[400, 672, 1000, 1344]} sizes="(min-width: 768px) 42rem, 92vw" class="aspect-[5/4] w-full object-cover" />
            <figcaption class="mt-2 text-center font-cond text-sm font-bold uppercase tracking-[0.1em] text-ink">Camo patch caps · {formatPrice(biz.merch.items.find((m) => m.item === 'Caps')?.price)}</figcaption>
          </figure>
          <ul class="reveal mt-8 flex flex-wrap justify-center gap-3">
            {biz.merch.items.map((m) => (
              <li class="hang-tag bg-ink font-cond text-lg font-bold uppercase tracking-[0.06em] text-cream [--tag-hole:var(--color-cream)]">
                {m.item}
                <span class="ml-2 text-blaze">{formatPrice(m.price, false, m.note)}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
