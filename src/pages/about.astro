---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import AntlerMark from '../components/AntlerMark.astro';
import Reviews from '../components/Reviews.astro';
import { biz, photo } from '../lib/business';

const crew = photo('crew-with-bison-quarter.jpg');
const table = photo('crew-with-bison-side.jpg');
const smoker = photo('pitmaster-at-the-smoker.jpg');
const youth = photo('father-and-son-whitetail.jpg');
const values = [
  { icon: 'shield', title: 'Your harvest, our care', text: "Every animal that hits the deck gets treated like it's going in our own freezer." },
  { icon: 'flame', title: 'Smoked right here', text: 'Sausage, jerky and snack sticks are made and smoked at the plant, from your own harvest.' },
  { icon: 'snowflake', title: 'Clean & fast', text: 'Hunters tell us it again and again: clean facility, quick turnaround, and everything packaged and boxed for pickup.' },
  { icon: 'star', title: 'Family on the deck', text: "The Fergusons and a hometown crew, many of them local students, run the plant every season." },
] as const;
---

<BaseLayout
  title="About Us"
  description="Rust Deer Plant has served Cisco, Texas for over 35 years. Since 2021, Dustin and Leta Ferguson have run it as a family-owned wild game processor specializing in smoked meats and European mounts."
>
  <PageHero
    eyebrow="Family-owned in Cisco, Texas"
    title="Made for those who like it wild"
    lead="A wild game plant with deep roots in Cisco, run by a family that loves hunting season as much as you do."
    photo={table}
    position="50% 45%"
  />

  <section class="on-light grain grain-light section bg-cream text-ink" aria-labelledby="story-title">
    <div class="container-x grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:items-center">
      <div class="reveal">
        <p class="eyebrow">Our story</p>
        <h2 id="story-title" class="mt-3 text-5xl sm:text-6xl">35+ years on Highway 6</h2>
        <div class="prose-rdp mt-6 text-lg text-ink/90">
          <p>
            Rust Deer Plant has been processing deer for Cisco and the Big Country for more than 35 years. Generations of local hunters have pulled up to this deck with something in the back of the truck.
          </p>
          <p>
            In 2021, <strong>{biz.owners}</strong> took over the plant and made it a family business. Here's how they put it:
          </p>
          <blockquote class="my-6 border-l-4 border-rust bg-bone/70 px-5 py-4 text-xl italic text-ink">
            “{biz.intro}”
          </blockquote>
          <p>
            Today the plant processes whitetail and mule deer, hogs, elk and exotics from all over the region. We smoke our own specialty sausage, jerky and snack sticks, and we turn out European mounts of all kinds. Opening weekend is a family affair, with food for hunters, sausage samples, and the whole crew on the deck.
          </p>
        </div>
      </div>
      <div class="reveal relative">
        <Picture src={crew.src} alt={crew.alt} formats={['avif', 'webp']} widths={[480, 720, 960]} sizes="(min-width: 1024px) 34rem, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover shadow-xl" />
        <AntlerMark class="absolute -bottom-8 -left-6 h-24 w-24 text-rust" />
      </div>
    </div>
  </section>

  <section class="grain section bg-char" aria-labelledby="values-title">
    <div class="container-x">
      <div class="reveal max-w-2xl">
        <p class="eyebrow">How we do it</p>
        <h2 id="values-title" class="mt-3 text-5xl text-cream sm:text-6xl">What you can count on</h2>
      </div>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v, i) => (
            <li class="reveal rounded-sm border border-white/10 bg-char-2 p-6" style={`transition-delay:${i * 70}ms`}>
              <Icon name={v.icon} class="h-8 w-8 text-blaze" />
              <h3 class="mt-4 text-2xl text-cream">{v.title}</h3>
              <p class="mt-2 text-bone">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="relative overflow-hidden bg-ink" aria-labelledby="tradition-title">
    <div class="grid md:grid-cols-2">
      <Picture src={smoker.src} alt={smoker.alt} formats={['avif', 'webp']} widths={[480, 720, 1080]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full max-h-[40rem] w-full object-cover" />
      <div class="grain section flex flex-col justify-center px-4 sm:px-10 lg:px-16">
        <p class="eyebrow reveal">Passing it on</p>
        <h2 id="tradition-title" class="reveal mt-3 text-5xl text-cream sm:text-6xl">The best part of the season</h2>
        <p class="reveal mt-5 text-lg text-bone">
          Nothing beats seeing a young hunter's face light up on the deck. Every first deer earns a spot in our <strong class="text-cream">First Harvest Club</strong>, with a free Rust shirt and a picture on our page. We love seeing families out in the woods making memories together.
        </p>
        <p class="reveal mt-4 text-bone">
          We're proud to support our military, first responders and Eastland County law enforcement too. Military and first responders get 20% off Basic Processing.
        </p>
        <div class="reveal mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/drop-off/" class="btn btn-primary">Drop-off guide <Icon name="arrow" /></a>
          <a href={biz.social.facebook} rel="noopener" target="_blank" class="btn btn-ghost">Follow on Facebook<span class="sr-only"> (opens Facebook)</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-char" aria-labelledby="about-reviews-title">
    <div class="container-x">
      <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow">In their words</p>
          <h2 id="about-reviews-title" class="mt-3 text-5xl text-cream sm:text-6xl">Our hunters</h2>
        </div>
        <Picture src={youth.src} alt={youth.alt} formats={['avif', 'webp']} widths={[320, 480]} sizes="12rem" class="hidden h-36 w-48 rounded-sm object-cover md:block" />
      </div>
      <div class="mt-10"><Reviews limit={9} /></div>
    </div>
  </section>
</BaseLayout>
