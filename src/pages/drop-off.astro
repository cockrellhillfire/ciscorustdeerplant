---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import HoursTable from '../components/HoursTable.astro';
import Icon from '../components/Icon.astro';
import { biz, photo, formatPrice } from '../lib/business';

const deck = photo('whitetail-buck-at-the-shop-door.jpg');
const careTips = [
  { title: 'Field dress fast', text: 'Get the guts out as soon as you can, especially on a warm day. Heat is the enemy of good venison. If you would rather we do it, bring the animal during business hours for the $75 field dress fee.' },
  { title: 'Cool it down', text: 'Prop the body cavity open so air moves through it, and keep it in the shade. On warm days, get it to us or into a cooler the same day.' },
  { title: 'Keep it clean and dry', text: 'Keep dirt, hair and water out of the cavity. If you ice it, keep the ice in bags so the meat does not sit in meltwater. Excessively dirty animals require a $25 clean-up fee.' },
  { title: 'Leave the hide on', text: 'There is no need to skin it. The hide protects the meat on the drive in, and our crew skins every animal here.' },
  { title: 'Tell us about the shot', text: 'Bloodshot or gut-shot meat gets trimmed, so knowing where you hit it helps us plan your cuts.' },
  { title: 'Want a euro or a mount?', text: 'Tell us at drop-off before anything is cut. Cape fees are $45, or $60 for a large cape. Do not cut the throat if you plan to cape it, and line up your taxidermist: we hold capes for 7 days.' },
];
const chapters = [
  { id: 'hours', label: 'Hours' },
  { id: 'where', label: 'Where to go' },
  { id: 'after-hours', label: 'After hours' },
  { id: 'payment', label: 'Payment' },
  { id: 'field-care', label: 'Field care' },
  { id: 'pickup', label: 'Pick-up' },
  { id: 'cape-pickup', label: 'Cape pickup' },
];
const req = biz.dropOff.requiredAtDropOff;
const cape = biz.pickup.capePolicy;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: biz.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const chapterHead = 'grid gap-4 md:grid-cols-[8rem_1fr] md:gap-10';
---

<BaseLayout
  title="Drop-Off Guide"
  description="How to drop off your deer, hog or exotic at Rust Deer Plant in Cisco, TX. Open 9 AM–9 PM daily October–January, after-hours drop-off on the back deck, payment policy and field care tips."
  jsonLd={[faqSchema]}
>
  <PageHero
    eyebrow="Before you head our way"
    title="Drop-off guide"
    ribbon={`${biz.hours.summary} · ${biz.season.months}`}
    photo={photo('check-in-area.jpg')}
    next="cream"
  />

  <!-- The tag: what to bring -->
  <section class="on-light grain grain-light bg-cream pb-16 pt-6 text-ink" aria-labelledby="bring-title">
    <div class="container-x grid items-center gap-10 lg:grid-cols-[1.1fr_1fr]">
      <div class="reveal relative mx-auto w-full max-w-md lg:order-2">
        <!-- wire -->
        <svg class="absolute -top-10 left-8 h-16 w-24 text-brown" viewBox="0 0 96 64" fill="none" aria-hidden="true"><path d="M4 4c30 6 40 40 40 56" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
        <div class="tilt-r relative rounded-[6px_6px_18px_18px] bg-blaze p-6 pt-12 text-ink shadow-2xl [clip-path:polygon(22%_0,78%_0,100%_14%,100%_100%,0_100%,0_14%)] sm:p-8 sm:pt-14">
          <span class="absolute left-1/2 top-5 h-5 w-5 -translate-x-1/2 rounded-full bg-cream shadow-[inset_0_0_0_3px_rgb(0_0_0/0.25)]" aria-hidden="true"></span>
          <p class="text-center font-cond text-sm font-bold uppercase tracking-[0.24em]">Rust Deer Plant · Drop-off tag</p>
          <h2 id="bring-title" class="mt-2 text-center text-5xl leading-none">What to bring</h2>
          <ul class="mt-5 space-y-3 text-[1.05rem] font-semibold">
            {
              biz.dropOff.bring.map((b) => (
                <li class="flex gap-3 border-b-2 border-dashed border-ink/30 pb-3 last:border-0">
                  <span class="mt-0.5 h-5 w-5 shrink-0 rounded-sm border-[3px] border-ink" aria-hidden="true" />
                  <span>{b}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="reveal lg:order-1">
        <p class="eyebrow">Tagging & license rules</p>
        <p class="mt-3 font-display text-4xl uppercase leading-none sm:text-5xl">Tag it before you move it</p>
        <p class="mt-4 text-brown">Hunters bring us game from all over Texas, New Mexico, Arizona and beyond. Tagging, harvest-log and carcass transport rules change from season to season and from state to state, so check with the state you hunted in. For Texas, see Texas Parks & Wildlife:</p>
        <ul class="mt-5 space-y-2">
          {
            biz.dropOff.tpwdLinks.map((l) => (
              <li>
                <a href={l.url} rel="noopener" target="_blank" class="inline-flex items-start gap-2 text-lg font-semibold text-rust-deep underline decoration-rust/40 decoration-2 underline-offset-4 hover:decoration-rust">
                  {l.label}
                  <Icon name="external" class="mt-1.5 h-4 w-4 shrink-0" />
                  <span class="sr-only">(opens tpwd.texas.gov)</span>
                </a>
              </li>
            ))
          }
        </ul>
        <nav aria-label="On this page" class="mt-8">
          <ol class="flex flex-wrap gap-2">
            {chapters.map((c, i) => (
              <li><a href={`#${c.id}`} class="inline-flex items-center gap-2 rounded-full border-2 border-ink px-3.5 py-1 font-cond text-sm font-bold uppercase tracking-[0.1em] hover:bg-ink hover:text-cream"><span class="text-rust">{String(i + 1).padStart(2, '0')}</span>{c.label}</a></li>
            ))}
          </ol>
        </nav>
      </div>
    </div>
  </section>

  <!-- Chapters -->
  <div class="grain bg-char">
    <div class="container-x max-w-5xl divide-y-2 divide-white/10">
      <section id="hours" class:list={['scroll-mt-20 py-16', chapterHead]} aria-labelledby="hours-title">
        <span class="numeral-outline text-8xl" aria-hidden="true">01</span>
        <div>
          <h2 id="hours-title" class="text-5xl text-cream sm:text-6xl">When we're open</h2>
          <p class="mt-4 text-lg text-bone">We're a seasonal plant, open {biz.season.months}. During the season we're here {biz.hours.summary}. {biz.hours.offSeason}</p>
          <div class="mt-6 max-w-xl text-bone"><HoursTable /></div>
          {biz.season.lastPickupDate && biz.season.lastPickupDate !== 'TODO' && <p class="mt-4 font-semibold text-cream">Last day for pickups this season: {biz.season.lastPickupDate}.</p>}
        </div>
      </section>

      <section id="where" class:list={['scroll-mt-20 py-16', chapterHead]} aria-labelledby="where-title">
        <span class="numeral-outline text-8xl" aria-hidden="true">02</span>
        <div class="grid items-start gap-8 lg:grid-cols-[1fr_16rem]">
          <div>
            <h2 id="where-title" class="text-5xl text-cream sm:text-6xl">Pull around back to the deck</h2>
            <p class="mt-4 text-lg text-bone">{biz.dropOff.where}. We're at {biz.address.street} in {biz.address.city}. {biz.address.note}</p>
            <a href={biz.directionsUrl} rel="noopener" target="_blank" class="btn btn-primary mt-6"><Icon name="pin" /> Get directions<span class="sr-only"> (opens Google Maps)</span></a>
          </div>
          <figure class="taped tilt-r2 mx-auto w-56 lg:w-full">
            <Picture src={deck.src} alt={deck.alt} formats={['avif', 'webp']} widths={[256, 400, 512]} sizes="16rem" class="aspect-[4/5] w-full object-cover" />
            <figcaption class="mt-2 text-center font-cond text-sm font-bold uppercase tracking-[0.1em] text-ink">On the deck</figcaption>
          </figure>
        </div>
      </section>

      <section id="after-hours" class:list={['scroll-mt-20 py-16', chapterHead]} aria-labelledby="after-title">
        <span class="numeral-outline text-8xl" aria-hidden="true">03</span>
        <div>
          <h2 id="after-title" class="text-5xl text-cream sm:text-6xl">After hours & holidays</h2>
          <p class="mt-4 text-lg text-bone">Hunting late, or over the holidays? Use the drop-off system on the back deck. The instructions are posted there too.</p>
          <ol class="mt-6 grid gap-4 sm:grid-cols-2">
            {
              biz.dropOff.afterHours.map((s, i) => (
                <li class="hang-tag bg-cream py-4 text-ink [--tag-hole:var(--color-char)]">
                  <span class="font-cond text-sm font-bold uppercase tracking-[0.16em] text-rust">Step {i + 1}</span>
                  <span class="mt-1 block">{s}</span>
                </li>
              ))
            }
          </ol>
          <p class="mt-6 flex gap-3 border-l-4 border-blaze bg-ink p-4 text-cream">
            <Icon name="flame" class="mt-0.5 h-5 w-5 shrink-0 text-blaze" />
            <span><strong>${biz.dropOff.gutsFeeAfterHours} fee:</strong> {biz.dropOff.gutsFeeAfterHoursNote.replace(/^An extra \$100 is charged/, 'Charged')}</span>
          </p>
        </div>
      </section>

      <section id="payment" class:list={['scroll-mt-20 py-16', chapterHead]} aria-labelledby="pay-title">
        <span class="numeral-outline text-8xl" aria-hidden="true">04</span>
        <div>
          <h2 id="pay-title" class="text-5xl text-cream sm:text-6xl">What you pay, and when</h2>
          <div class="mt-6 grid overflow-hidden rounded-sm border-2 border-white/15 sm:grid-cols-2">
            <div class="p-5">
              <p class="font-cond text-sm font-bold uppercase tracking-[0.16em] text-blaze">Required at drop-off</p>
              <p class="mt-2 font-display text-3xl uppercase leading-tight text-cream">{req.lead}</p>
              <ul class="mt-3 space-y-1">
                {req.items.map((it) => (
                  <li class="flex items-baseline justify-between gap-4 border-b border-dashed border-white/15 pb-1 text-bone">
                    <span>{it.item}</span><span class="font-display text-2xl text-cream">{formatPrice(it.price)}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-3 text-sm text-sand">{req.cleanupNote}</p>
            </div>
            <div class="border-t-2 border-dashed border-white/15 p-5 sm:border-l-2 sm:border-t-0">
              <p class="font-cond text-sm font-bold uppercase tracking-[0.16em] text-blaze">At pick-up</p>
              <p class="mt-2 font-display text-3xl uppercase leading-tight text-cream">The rest, including specialty items</p>
            </div>
          </div>
          <p class="mt-5 text-lg text-bone">We take {biz.payment.methods.join(', ').toLowerCase()}. {biz.payment.cashNote}</p>
          <p class="mt-2 text-bone"><strong class="text-cream">{biz.discounts[0].title}:</strong> {biz.discounts[0].text}</p>
        </div>
      </section>

      <section id="field-care" class:list={['scroll-mt-20 py-16', chapterHead]} aria-labelledby="care-title">
        <span class="numeral-outline text-8xl" aria-hidden="true">05</span>
        <div>
          <h2 id="care-title" class="text-5xl text-cream sm:text-6xl">Get it here in good shape</h2>
          <p class="mt-4 text-lg text-bone">Great sausage and steaks start in the field. A few habits make a big difference in what comes back to you.</p>
          <dl class="mt-8 grid gap-x-10 gap-y-7 sm:grid-cols-2">
            {
              careTips.map((t, i) => (
                <div class="reveal">
                  <dt class="flex items-baseline gap-3 font-display text-3xl uppercase text-cream">
                    <span class="font-cond text-base font-bold text-blaze">{String.fromCharCode(65 + i)}.</span>
                    {t.title}
                  </dt>
                  <dd class="mt-1 text-bone">{t.text}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <section id="pickup" class:list={['scroll-mt-20 py-16', chapterHead]} aria-labelledby="pickup-title">
        <span class="numeral-outline text-8xl" aria-hidden="true">06</span>
        <div>
          <h2 id="pickup-title" class="text-5xl text-cream sm:text-6xl">When it's ready</h2>
          <p class="mt-4 text-lg text-bone">{biz.pickup.freezerNote}</p>
          <p class="mt-3 text-bone">{biz.pickup.donationNote} Pickup-only hours at the end of the season are posted on <a href={biz.social.facebook} rel="noopener" target="_blank" class="text-cream underline decoration-blaze decoration-2">our Facebook page</a>.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={`tel:${biz.phone.tel}`} class="btn btn-primary"><Icon name="phone" /> {biz.phone.display}</a>
            <a href={`tel:${biz.phoneAlt.tel}`} class="btn btn-ghost">{biz.phoneAlt.display}</a>
          </div>
        </div>
      </section>

      <section id="cape-pickup" class:list={['scroll-mt-20 py-16', chapterHead]} aria-labelledby="cape-title">
        <span class="numeral-outline text-8xl" aria-hidden="true">07</span>
        <div>
          <p class="font-cond text-sm font-bold uppercase tracking-[0.2em] text-blaze">Notice to hunters</p>
          <h2 id="cape-title" class="mt-1 text-5xl text-cream sm:text-6xl">{cape.title}</h2>
          <p class="mt-4 text-lg text-bone">{cape.points[0]}</p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="hang-tag bg-cream py-4 text-ink [--tag-hole:var(--color-char)]">
              <span class="block font-display text-4xl uppercase leading-none text-rust">{cape.holdDays}-day hold</span>
              <span class="mt-1 block">{cape.points[1]}</span>
            </div>
            <div class="hang-tag bg-blaze py-4 text-ink [--tag-hole:var(--color-char)]">
              <span class="block font-display text-4xl uppercase leading-none">${cape.feePerDay} per day</span>
              <span class="mt-1 block">{cape.points[2]}</span>
            </div>
          </div>
          <p class="mt-5 flex gap-3 border-l-4 border-blaze bg-ink p-4 text-cream">
            <Icon name="snowflake" class="mt-0.5 h-5 w-5 shrink-0 text-blaze" />
            <span>{cape.points[3]}</span>
          </p>
        </div>
      </section>
    </div>
  </div>

  <!-- FAQ -->
  <section class="on-light grain grain-light section bg-cream text-ink" aria-labelledby="faq-title">
    <div class="container-x max-w-3xl">
      <div class="text-center">
        <p class="ruled eyebrow">FAQ</p>
        <h2 id="faq-title" class="mt-3 text-6xl">Common questions</h2>
      </div>
      <div class="mt-10 space-y-3">
        {
          biz.faq.map((f) => (
            <details class="group rounded-sm border-2 border-ink/80 bg-[#fbf6ec] open:bg-white">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-cond text-xl font-bold uppercase tracking-[0.04em] marker:hidden [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink text-cream transition group-open:rotate-45" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                </span>
              </summary>
              <p class="px-5 pb-5 text-brown">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
