---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import AntlerMark from '../components/AntlerMark.astro';
import HoursTable from '../components/HoursTable.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { biz, photo, formatTime, formatPrice } from '../lib/business';

const hero = photo('bison-bull-family-hunt.jpg');
const firstHarvestPhotos = biz.firstHarvest.photos.map((f) => photo(f));
const h = biz.hours.days[0];
const hoursSummary = `${formatTime(h.open)} – ${formatTime(h.close)}`;
const p = biz.pricing;

// The menu board: what we do, with a starting price pulled from business.json.
const board = [
  { n: '01', title: 'Deer processing', text: biz.services[0].text, from: formatPrice(p.basicProcessing.items[0].price), note: 'whitetail', href: '/services/#basic-processing', img: photo('heavy-whitetail-buck.jpg') },
  { n: '02', title: 'Hogs & exotics', text: biz.services[1].text, from: formatPrice(p.hogProcessing.items[0].price), note: 'hogs', href: '/exotics/', img: photo('axis-buck-in-velvet.jpg') },
  { n: '03', title: 'Smoked specialties', text: biz.services[2].text, from: formatPrice(p.linkSausage.items[2].price, true), note: 'link sausage', href: '/services/#link-sausage', img: photo('jalapeno-cheese-summer-sausage.jpg') },
  { n: '04', title: 'European mounts', text: biz.services[3].text, from: formatPrice(p.feesAndEuros.items[3].price), note: 'per mount', href: '/services/#fees-and-euros', img: photo('tall-whitetail-euro.jpg') },
];

const species = ['Whitetail', 'Mule deer', 'Elk', 'Axis', 'Fallow', 'Red stag', 'Aoudad', 'Oryx', 'Kudu', 'Eland', 'Bison', 'Hogs'];

const smoke = [photo('sausage-rings-on-racks.jpg'), photo('jerky-in-the-smoker.jpg'), photo('summer-sausage-and-links.jpg')];
const tags: { name: string; kind: string; isNew?: boolean }[] = [
  ...biz.flavors.linkSausage.map((f) => ({ name: f.name, kind: 'Link' })),
  ...biz.flavors.summerSausage.map((f) => ({ name: f.name, kind: 'Summer' })),
  ...biz.flavors.jerky.map((f) => ({ name: f.name, kind: 'Jerky' })),
  ...biz.flavors.snackSticks.map((f) => ({ name: f.name, kind: 'Sticks', isNew: true })),
];

const trail = [
  { icon: 'truck', title: 'Pull up to the deck', text: `${biz.dropOff.where}. ${hoursSummary} daily in season, or use the tag drop-off after hours.` },
  { icon: 'ticket', title: 'Fill out your cut ticket', text: 'Steaks, roasts, grind, plus any sausage, jerky or snack sticks. We will help you pick.' },
  { icon: 'cash', title: 'Pay the basics', text: 'Basic processing, plus any cape or field dress fee, at drop-off. The rest at pick-up.' },
  { icon: 'snowflake', title: 'We call, you pick up', text: `Packaged and boxed. Pick up within ${biz.pickup.freezerFreeDays} days of our call.` },
] as const;

const board2 = [
  { p: photo('giant-whitetail-buck.jpg'), tilt: 'tilt-l', span: 'row-span-2' },
  { p: photo('two-aoudad-rams.jpg'), tilt: 'tilt-r', span: '' },
  { p: photo('youth-hunter-red-stag.jpg'), tilt: 'tilt-r2', span: 'row-span-2' },
  { p: photo('axis-steak-medium-rare.jpg'), tilt: 'tilt-l2', span: '' },
  { p: photo('mule-deer-buck-at-dusk.jpg'), tilt: 'tilt-r', span: '' },
  { p: photo('pitmaster-at-the-smoker.jpg'), tilt: 'tilt-l', span: '' },
];

const [featured, ...moreReviews] = [biz.reviews[1], ...biz.reviews.filter((_, i) => i !== 1)];
---

<BaseLayout
  fullTitle
  title="Rust Deer Plant | Deer & Wild Game Processing in Cisco, TX"
  description="Family-owned deer and wild game processing in Cisco, Texas. Whitetail, mule deer, elk, hogs and exotics, smoked sausage and jerky, and European mounts. Open 9 AM–9 PM daily in season."
>
  <!-- HERO: centered flyer composition -->
  <section class="relative isolate overflow-hidden bg-ink">
    <!-- Wide screens: a blurred copy of the photo fills the sides of the portrait shot. -->
    <Picture
      src={hero.src}
      alt=""
      formats={['avif', 'webp']}
      widths={[480]}
      quality={40}
      sizes="480px"
      loading="lazy"
      class="absolute inset-0 -z-30 hidden h-full w-full scale-110 object-cover opacity-45 blur-2xl sm:block"
    />
    <!-- Sized so the faces sit above the wording and the bison's head shows below them. -->
    <Picture
      src={hero.src}
      alt={hero.alt}
      formats={['avif', 'webp']}
      widths={[640, 960, 1320]}
      sizes="(min-width: 640px) 720px, 660px"
      loading="eager"
      fetchpriority="high"
      class="absolute left-1/2 top-[-338px] -z-20 h-[960px] w-auto max-w-none -translate-x-[59%] sm:top-[-52%] sm:h-[150%] sm:-translate-x-[57%] sm:[mask-image:linear-gradient(90deg,transparent,#000_16%,#000_84%,transparent)]"
    />
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(18_16_14/0.1)_0%,rgb(18_16_14/0.16)_16%,rgb(18_16_14/0.42)_32%,rgb(18_16_14/0.5)_70%,rgb(18_16_14/0.7)_100%)]" aria-hidden="true"></div>

    <div class="container-x flex min-h-[min(82svh,48rem)] flex-col items-center justify-start pb-6 pt-[8.5rem] text-center [text-shadow:0_2px_12px_rgb(0_0_0/0.85)] sm:justify-end sm:pb-24 sm:pt-14">
      <p class="script animate-rise text-3xl text-blaze [animation-delay:60ms] sm:text-4xl">{biz.tagline}</p>
      <h1 class="mt-2 animate-rise [animation-delay:120ms]">
        <span class="rough-text block text-[3.7rem] leading-[0.88] text-cream sm:text-[7rem] lg:text-[9.5rem]">Rust Deer Plant</span>
        <span class="ruled mt-4 font-cond text-base font-bold tracking-[0.22em] text-bone sm:text-2xl"><span>Wild Game Processing<span class="hidden sm:inline"> <span class="text-blaze">·</span> Cisco, Texas</span></span></span>
        <span class="mt-1 block font-cond text-base font-bold uppercase tracking-[0.22em] text-blaze sm:hidden">Cisco, Texas</span>
      </h1>
      <p class="mt-6 max-w-xl animate-rise text-lg text-bone [animation-delay:180ms] sm:text-xl">
        Deer, hogs and exotics cut the way you want. Smoked sausage, jerky and euros of all kinds. Family-run on Highway 6.
      </p>
      <div class="mt-8 flex w-full animate-rise flex-col justify-center gap-3 [animation-delay:240ms] [text-shadow:none] sm:w-auto sm:flex-row">
        <a href={`tel:${biz.phone.tel}`} class="btn btn-primary"><Icon name="phone" /> Call now</a>
        <a href={biz.directionsUrl} class="btn btn-ghost" rel="noopener" target="_blank"><Icon name="pin" /> Get directions<span class="sr-only"> (opens Google Maps)</span></a>
        <a href="#hours" class="btn btn-ghost"><Icon name="clock" /> Hours</a>
      </div>
    </div>

    <!-- Hours ribbon across the bottom of the hero -->
    <div class="relative flex justify-center px-3 pb-8 sm:absolute sm:inset-x-0 sm:bottom-6 sm:pb-0">
      <p class="ribbon ribbon-skew px-8 py-2.5 text-center font-cond text-[1.05rem] font-bold uppercase tracking-[0.1em] shadow-2xl sm:px-14 sm:text-2xl" data-open-status data-season={biz.season.status} data-hours={JSON.stringify(biz.hours.days)}>
        <span data-open-text>Open {hoursSummary} · Seven days a week</span>
      </p>
    </div>
  </section>

  <!-- SPECIES TICKER -->
  <section aria-label="What we process" class="border-y border-white/10 bg-char py-4">
    <div class="ticker">
      <ul class="ticker-track items-center gap-x-8 font-display text-3xl uppercase text-bone sm:text-4xl">
        {species.map((s) => <li class="flex items-center gap-8">{s}<AntlerMark class="h-6 w-6 text-blaze" /></li>)}
        {species.map((s) => <li class="flex items-center gap-8" aria-hidden="true">{s}<AntlerMark class="h-6 w-6 text-blaze" /></li>)}
      </ul>
    </div>
  </section>

  <!-- MENU BOARD -->
  <section class="on-light grain grain-light section bg-cream text-ink" aria-labelledby="board-title">
    <div class="container-x max-w-5xl">
      <div class="reveal text-center">
        <p class="ruled eyebrow">What we do</p>
        <h2 id="board-title" class="mt-3 text-6xl sm:text-7xl">The menu board</h2>
        <p class="mx-auto mt-4 max-w-xl text-brown">Basic processing on any animal includes steaks and roasts cut, plus burger and chili ground. Everything else is up to you.</p>
      </div>
      <ol class="mt-12 border-t-[3px] border-ink">
        {
          board.map((b) => (
            <li class="reveal border-b-[3px] border-ink">
              <a href={b.href} class="group grid grid-cols-[auto_1fr] items-center gap-x-5 gap-y-3 py-7 sm:grid-cols-[auto_1fr_auto] sm:gap-x-8 md:grid-cols-[auto_9rem_1fr_auto]">
                <span class="numeral-outline text-6xl sm:text-7xl" aria-hidden="true">{b.n}</span>
                <span class="hidden overflow-hidden rounded-full md:block">
                  <Picture src={b.img.src} alt="" formats={['avif', 'webp']} widths={[160, 288]} sizes="9rem" class="aspect-square w-36 object-cover grayscale transition duration-500 group-hover:scale-110 group-hover:grayscale-0" />
                </span>
                <span>
                  <span class="block font-display text-4xl uppercase leading-none transition-colors group-hover:text-rust sm:text-5xl">{b.title}</span>
                  <span class="mt-2 block max-w-md text-brown">{b.text}</span>
                </span>
                <span class="col-span-2 flex items-baseline gap-2 sm:col-span-1 sm:block sm:text-right">
                  <span class="font-cond text-sm font-bold uppercase tracking-[0.14em] text-brown">From</span>
                  <span class="block font-display text-5xl text-rust sm:text-6xl">{b.from}</span>
                  <span class="text-sm text-brown">{b.note}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="reveal mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href="/services/" class="btn btn-dark">See the full price guide <Icon name="arrow" /></a>
        <p class="font-cond font-bold uppercase tracking-[0.12em] text-rust-deep">Rush orders: ask for pricing</p>
      </div>
    </div>
  </section>

  <!-- SMOKEHOUSE -->
  <section class="grain section relative overflow-hidden bg-ink" aria-labelledby="smoke-title">
    <div class="container-x text-center">
      <p class="ruled eyebrow reveal">From the smokehouse</p>
      <h2 id="smoke-title" class="reveal mt-3 text-6xl text-cream sm:text-7xl">Made from your harvest</h2>
      <p class="reveal mx-auto mt-4 max-w-2xl text-lg text-bone">Add any of these to your cut ticket and we'll smoke them right here at the plant. {biz.flavors.note}</p>

      <div class="relative mx-auto mt-14 grid max-w-4xl grid-cols-3 items-center gap-2 sm:gap-6">
        {
          smoke.map((s, i) => (
            <figure class:list={['taped reveal', i === 0 ? 'tilt-l' : i === 1 ? 'z-10 scale-110 tilt-r2' : 'tilt-r']}>
              <Picture src={s.src} alt={s.alt} formats={['avif', 'webp']} widths={[240, 400, 560]} sizes="(min-width: 1024px) 18rem, 32vw" class="aspect-[4/5] w-full object-cover" />
            </figure>
          ))
        }
      </div>

      <ul class="mx-auto mt-16 flex max-w-4xl flex-wrap justify-center gap-3" aria-label="Flavors">
        {
          tags.map((t, i) => (
            <li class:list={['reveal', i % 3 === 0 ? 'tilt-l2' : i % 3 === 1 ? 'tilt-r' : '']} style={`transition-delay:${(i % 6) * 50}ms`}>
              <span class:list={['hang-tag inline-flex items-baseline gap-2 text-left', t.isNew ? 'bg-blaze text-ink [--tag-hole:var(--color-ink)]' : 'bg-cream text-ink [--tag-hole:var(--color-ink)]']}>
                <span class="font-cond text-[0.7rem] font-bold uppercase tracking-[0.16em] opacity-70">{t.kind}</span>
                <span class="font-cond text-lg font-bold uppercase tracking-[0.04em]">{t.name}</span>
                {t.isNew && <span class="font-cond text-[0.7rem] font-bold uppercase tracking-[0.16em]">New</span>}
              </span>
            </li>
          ))
        }
      </ul>

      <div class="reveal mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <p class="rounded-sm border-2 border-blaze px-5 py-2.5 font-display text-2xl uppercase text-cream">{biz.pricing.minimum}</p>
        <a href="/services/#link-sausage" class="btn btn-primary">Sausage & jerky prices <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- TRAIL: how drop-off works -->
  <section class="grain section bg-char" aria-labelledby="trail-title">
    <div class="container-x">
      <div class="reveal text-center">
        <p class="ruled eyebrow">How it works</p>
        <h2 id="trail-title" class="mt-3 text-6xl text-cream sm:text-7xl">From the truck to the freezer</h2>
      </div>
      <ol class="relative mt-14 grid gap-10 md:grid-cols-4 md:gap-6">
        <li class="pointer-events-none absolute left-[1.9rem] top-0 hidden h-full md:left-[12.5%] md:right-[12.5%] md:top-[1.9rem] md:block md:h-auto" aria-hidden="true">
          <span class="perforated-x block w-full text-blaze/60"></span>
        </li>
        <li class="pointer-events-none absolute bottom-0 left-[1.9rem] top-0 md:hidden" aria-hidden="true"><span class="perforated-y block h-full text-blaze/60"></span></li>
        {
          trail.map((t, i) => (
            <li class="reveal relative grid grid-cols-[3.8rem_1fr] gap-5 md:flex md:flex-col md:items-center md:text-center" style={`transition-delay:${i * 90}ms`}>
              <span class="relative z-10 flex h-[3.8rem] w-[3.8rem] items-center justify-center rounded-full border-[3px] border-blaze bg-ink text-blaze">
                <Icon name={t.icon} class="h-7 w-7" />
              </span>
              <span>
                <span class="block font-cond text-sm font-bold uppercase tracking-[0.2em] text-blaze">Step {i + 1}</span>
                <span class="mt-1 block font-display text-3xl uppercase leading-none text-cream">{t.title}</span>
                <span class="mt-2 block text-bone">{t.text}</span>
              </span>
            </li>
          ))
        }
      </ol>
      <div class="reveal mt-12 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/drop-off/" class="btn btn-primary">Read the drop-off guide <Icon name="arrow" /></a>
        <a href="/drop-off/#after-hours" class="btn btn-ghost">After-hours drop-off</a>
      </div>
    </div>
  </section>

  <!-- BRAG BOARD -->
  <section class="section relative overflow-hidden bg-[#2b221b]" aria-labelledby="brag-title">
    <div class="pointer-events-none absolute inset-0 opacity-60 [background:radial-gradient(circle_at_20%_10%,rgb(147_112_79/0.35),transparent_45%),radial-gradient(circle_at_85%_80%,rgb(147_112_79/0.25),transparent_40%)]" aria-hidden="true"></div>
    <div class="container-x relative">
      <div class="reveal text-center">
        <p class="ruled eyebrow">{biz.hashtag}</p>
        <h2 id="brag-title" class="mt-3 text-6xl text-cream sm:text-7xl">The brag board</h2>
        <p class="mx-auto mt-4 max-w-xl text-bone">Every harvest that hits our deck gets its picture taken. Here are a few from this season and last.</p>
      </div>

      <div class="mt-14 grid auto-rows-[11rem] grid-cols-2 gap-5 sm:auto-rows-[13rem] md:grid-cols-4 md:gap-7">
        {
          board2.map((b) => (
            <a href="/gallery/" class:list={['taped reveal block', b.tilt, b.span]}>
              <Picture src={b.p.src} alt={b.p.alt} formats={['avif', 'webp']} widths={[300, 480, 640]} sizes="(min-width: 768px) 22vw, 46vw" class="h-full w-full object-cover" />
            </a>
          ))
        }

      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <div class="reveal tilt-r2 grid items-center gap-5 bg-blaze p-5 text-ink shadow-xl sm:grid-cols-[12rem_1fr] sm:p-6 md:col-span-2">
          <div class="relative mx-auto aspect-[4/5] w-full max-w-[14rem] overflow-hidden border-4 border-cream bg-ink shadow-lg sm:max-w-none" data-rotator>
            {
              firstHarvestPhotos.map((f, i) => (
                <Picture
                  src={f.src}
                  alt={f.alt}
                  formats={['avif', 'webp']}
                  widths={[240, 400]}
                  sizes="(min-width: 640px) 12rem, 14rem"
                  class:list={['absolute inset-0 h-full w-full object-cover transition-opacity duration-700', i === 0 ? 'opacity-100' : 'opacity-0']}
                  aria-hidden={i === 0 ? undefined : 'true'}
                  data-slide
                />
              ))
            }
          </div>
          <div>
            <p class="font-cond text-sm font-bold uppercase tracking-[0.2em]">First Harvest Club</p>
            <p class="mt-1 font-display text-4xl uppercase leading-none">First deer? Let's celebrate.</p>
            <p class="mt-2 text-[0.98rem]">{biz.firstHarvest.text}</p>
          </div>
        </div>
        <div class="reveal tilt-l2 bg-cream p-6 text-ink shadow-xl">
          <p class="flex items-center gap-2 font-cond text-sm font-bold uppercase tracking-[0.2em] text-rust"><Icon name="shield" class="h-5 w-5" /> {biz.discounts[0].title}</p>
          <p class="mt-2 font-display text-3xl uppercase leading-none">20% off basic processing</p>
          <p class="mt-2 text-brown">Just let us know when you drop off. Thank you for your service.</p>
        </div>
      </div>

      <p class="mt-12 text-center">
        <a href="/gallery/" class="btn btn-ghost">See the whole gallery <Icon name="arrow" /></a>
      </p>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="on-light grain grain-light section bg-cream text-ink" aria-labelledby="reviews-title">
    <div class="container-x">
      <h2 id="reviews-title" class="sr-only">What hunters say</h2>
      <figure class="reveal mx-auto max-w-4xl text-center">
        <span class="font-display text-[8rem] leading-[0.6] text-rust" aria-hidden="true">“</span>
        <blockquote class="font-display text-3xl uppercase leading-[1.08] sm:text-[2.6rem]">
          <p>{featured.text}</p>
        </blockquote>
        <figcaption class="mt-6 font-cond text-lg font-bold uppercase tracking-[0.16em] text-rust-deep">{featured.name} · Facebook review</figcaption>
      </figure>
      <p class="ruled mt-12 font-cond font-bold uppercase tracking-[0.14em] text-brown">
        <span class="inline-flex items-center gap-2"><Icon name="star" class="h-4 w-4 fill-current text-rust" /> {biz.reviewSummary}</span>
      </p>
      <ul class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4" tabindex="0" aria-label="More reviews, scrollable">
        {
          moreReviews.map((r) => (
            <li class="w-[80vw] max-w-[22rem] shrink-0 snap-start">
              <figure class="flex h-full flex-col border-l-4 border-rust bg-bone/70 p-5">
                <blockquote class="flex-1 text-[1rem]"><p>“{r.text}”</p></blockquote>
                <figcaption class="mt-3 font-cond font-bold uppercase tracking-[0.12em] text-rust-deep">{r.name}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-center">
        <a href={`${biz.social.facebook}/reviews`} rel="noopener" target="_blank" class="inline-flex items-center gap-2 font-cond font-bold uppercase tracking-[0.12em] text-rust-deep underline decoration-2 underline-offset-4 hover:no-underline">
          Read all reviews on Facebook <Icon name="external" class="h-4 w-4" /><span class="sr-only">(opens Facebook)</span>
        </a>
      </p>
    </div>
  </section>

  <!-- VISIT: ticket stub -->
  <section id="hours" class="grain section bg-ink" aria-labelledby="visit-title">
    <div class="container-x">
      <div class="reveal ticket grid overflow-hidden rounded-md bg-cream text-ink [--notch-x:38%] md:grid-cols-[38%_62%]">
        <div class="on-light relative p-6 sm:p-8">
          <p class="font-cond text-sm font-bold uppercase tracking-[0.2em] text-rust">Hours & directions</p>
          <h2 id="visit-title" class="mt-2 text-5xl leading-none">Come see us</h2>
          <p class="mt-3 text-brown">{biz.address.note}</p>
          <div class="mt-5 text-ink"><HoursTable light compact /></div>
          <div class="mt-6 flex flex-col gap-3">
            <a href={`tel:${biz.phone.tel}`} class="btn btn-dark"><Icon name="phone" /> {biz.phone.display}</a>
            <a href={biz.directionsUrl} rel="noopener" target="_blank" class="btn border-ink/30 text-ink hover:border-ink"><Icon name="pin" /> Directions<span class="sr-only"> (opens Google Maps)</span></a>
          </div>
          <span class="perforated-y absolute bottom-6 right-0 top-6 hidden text-brown/50 md:block" aria-hidden="true"></span>
          <span class="perforated-x absolute bottom-0 left-6 right-6 text-brown/50 md:hidden" aria-hidden="true"></span>
        </div>
        <MapEmbed class="min-h-[22rem] rounded-none border-0" />
      </div>
    </div>
  </section>

  <script>
    // First Harvest Club: crossfade through the photos. Holds on the first one for reduced motion.
    const rotator = document.querySelector<HTMLElement>('[data-rotator]');
    const slides = rotator ? Array.from(rotator.querySelectorAll<HTMLElement>('[data-slide]')) : [];
    if (slides.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let current = 0;
      let timer: number | undefined;
      const show = (n: number) => {
        slides[current].classList.replace('opacity-100', 'opacity-0');
        slides[current].setAttribute('aria-hidden', 'true');
        current = n % slides.length;
        slides[current].classList.replace('opacity-0', 'opacity-100');
        slides[current].removeAttribute('aria-hidden');
      };
      const start = () => { timer ??= window.setInterval(() => show(current + 1), 3500); };
      const stop = () => { window.clearInterval(timer); timer = undefined; };
      // Only run while the card is on screen.
      new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(rotator!);
    }
  </script>

  <script>
    // Live "open now" status in Cisco, TX time. Without JS the ribbon shows the regular hours.
    const wrap = document.querySelector<HTMLElement>('[data-open-status]');
    const el = document.querySelector('[data-open-text]');
    if (wrap && el && wrap.dataset.season === 'open') {
      const days: { day: string; open: string; close: string }[] = JSON.parse(wrap.dataset.hours ?? '[]');
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Chicago',
        weekday: 'long',
        year: 'numeric',
        month: 'numeric',
        day: 'numeric',
        hour: 'numeric',
        minute: 'numeric',
        hourCycle: 'h23',
      }).formatToParts(new Date());
      const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
      const [y, m, d] = [Number(get('year')), Number(get('month')), Number(get('day'))];
      // Holiday closures: Thanksgiving (4th Thursday of November), Christmas Eve, Christmas Day.
      const firstThu = ((4 - new Date(y, 10, 1).getDay() + 7) % 7) + 1;
      const holiday = (m === 11 && d === firstThu + 21) || (m === 12 && (d === 24 || d === 25));
      const day = days.find((x) => x.day === get('weekday'));
      const mins = Number(get('hour')) * 60 + Number(get('minute'));
      const toMin = (s: string) => Number(s.slice(0, 2)) * 60 + Number(s.slice(3, 5));
      const fmt = (s: string) => {
        const h = Number(s.slice(0, 2));
        return `${h % 12 || 12} ${h >= 12 ? 'PM' : 'AM'}`;
      };
      if (holiday) {
        el.textContent = 'Closed today for the holiday · Back-deck drop-off is open';
      } else if (day) {
        const open = mins >= toMin(day.open) && mins < toMin(day.close);
        el.textContent = open
          ? `Open now · Until ${fmt(day.close)} tonight`
          : `Closed now · Opens ${fmt(day.open)} ${mins < toMin(day.open) ? 'today' : 'tomorrow'} · Drop-off on the back deck`;
      }
    }
  </script>
</BaseLayout>
